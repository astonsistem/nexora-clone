# Salin ke `.env` di root project:  cp .env.example .env

# Login lokal + data contoh (default). Set false untuk OAuth/API production.
LOCAL_LOGIN_MODE=true

# API mobile attendance (hanya jika LOCAL_LOGIN_MODE=false)
API_BASE_URL=https://your-api.example.com/absensi

# OAuth APG OneId — daftarkan redirect Nexora di client OAuth
OAUTH_URL=https://one.example.com/authorize
OAUTH_CLIENT_ID=your_client_id
OAUTH_REDIRECT_URI=amazink-absensi://login-callback

# Branding
APP_NAME=Nexora

# Opsional: link notifikasi ke web HRIS
HRIS_WEB_URL=https://your-hris.example.com/hris

# Firebase — app Android/iOS com.nexora.amazinkpeoplegroup (lihat docs/FIREBASE_SETUP.md)
FIREBASE_API_KEY=
FIREBASE_APP_ID_ANDROID=
FIREBASE_APP_ID_IOS=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
